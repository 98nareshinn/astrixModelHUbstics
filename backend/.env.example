# Bhoomi Saathi backend — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# MySQL connection (see database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bhoomi_saathi

# JWT auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Demo shared admin login (matches the documented demo credentials)
ADMIN_EMAIL=admin@bhoomisaathi.in
ADMIN_PASSWORD=admin123
